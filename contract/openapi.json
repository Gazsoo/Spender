        "required": [
          "amount",
          "description",
          "date",
          "categoryId",
          "expenseType"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "expenseType": {
            "$ref": "#/components/schemas/ExpenseType"
          },
          "paidById": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "fundedById": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "DebtByPerson": {
        "required": [
          "personName",
          "personId",
          "debt",
          "transactionCount"
        ],
        "type": "object",
        "properties": {
          "personId": {
            "type": "integer",
            "format": "int32"
          },
          "personName": {
            "type": "string"
          },
          "debt": {
            "type": "number",
            "format": "double"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DebtSummary": {
        "required": [
          "perspectiveId",
          "perspectiveName",
          "netDebt",
          "transactionCount",
          "breakdown"
        ],
        "type": "object",
        "properties": {
          "perspectiveId": {
            "type": "integer",
            "format": "int32"
          },
          "perspectiveName": {
            "type": "string"
          },
          "netDebt": {
            "type": "number",
            "format": "double"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int32"
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DebtByPerson"
            }
          }
        }
      },
      "ExpenseType": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "x-enumNames": [
          "Personal",
          "Shared",
          "SharedPrepaidJoint",
          "SharedPrepaidByOne"
        ]
      },
      "ForecastDayDto": {
        "required": [
          "date",
          "tempMin",
          "tempMax",
          "weatherCode",
          "precipitationMm"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "tempMin": {
            "type": "number",
            "format": "double"
          },
          "tempMax": {
            "type": "number",
            "format": "double"
          },
          "weatherCode": {
            "type": "integer",
            "format": "int32"
          },
          "precipitationMm": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "GoogleLoginRequest": {
        "required": [
          "credential"
        ],
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          }
        }
      },
