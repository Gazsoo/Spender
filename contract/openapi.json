            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CategorySummary": {
        "required": [
          "categoryName",
          "categoryId",
          "amount",
          "transactionCount"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryName": {
            "type": "string"
          },
          "color": {
            "type": [
              "null",
              "string"
            ]
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateCategoryRequest": {
        "required": [
