          "feelsLike",
          "humidity",
          "pressure",
          "windSpeed",
          "weatherCode",
          "updatedAt",
          "forecast"
        ],
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number",
            "format": "double"
          },
          "feelsLike": {
            "type": "number",
            "format": "double"
          },
          "humidity": {
            "type": "number",
            "format": "double"
          },
          "pressure": {
            "type": "number",
            "format": "double"
