        "required": [
          "temperature",
          "feelsLike",
          "feelsLikeHeatIndex",
          "humidity",
          "pressure",
          "windSpeed",
          "windDirection",
          "stationName",
          "observedAt"
        ],
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number",
            "format": "double"
          },
          "feelsLike": {
            "type": "number",
            "format": "double"
          },
          "feelsLikeHeatIndex": {
            "type": "number",
            "format": "double"
          },
          "humidity": {
            "type": "number",
            "format": "double"
          },
          "pressure": {
            "type": "number",
            "format": "double"
          },
          "windSpeed": {
            "type": "number",
            "format": "double"
          },
          "windDirection": {
            "type": "integer",
            "format": "int32"
          },
          "stationName": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
